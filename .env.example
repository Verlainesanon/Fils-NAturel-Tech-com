# Base de données PostgreSQL.
# En ligne : Render la fournit automatiquement (voir docs/DEPLOIEMENT.md).
# En local : copiez l'« External Database URL » de votre base Render.
DATABASE_URL="postgresql://utilisateur:motdepasse@hote:5432/base"

# Clé de signature des sessions client. En production, une longue chaîne
# aléatoire, gardée secrète, et surtout stable : la changer déconnecte
# tous les clients.
SESSION_SECRET="a-remplacer-par-une-longue-chaine-aleatoire"

# Mot de passe du compte propriétaire créé par `npm run db:seed`.
# S'il n'est pas défini, le seed utilise « FNTC-admin-2026 ».
# ADMIN_MOTDEPASSE="votre-mot-de-passe-solide"
