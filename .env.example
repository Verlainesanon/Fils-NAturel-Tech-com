# Base de données.
# Local : SQLite, rien à installer.
DATABASE_URL="file:./dev.db"
# En ligne (Neon/PostgreSQL) : remplacer par l'URL fournie, et changer
# `provider = "sqlite"` en `provider = "postgresql"` dans prisma/schema.prisma.
# DATABASE_URL="postgresql://utilisateur:motdepasse@hote/base?sslmode=require"

# Clé de signature des sessions client. Obligatoire en production :
# une valeur longue et aléatoire, gardée secrète.
SESSION_SECRET="a-remplacer-par-une-longue-chaine-aleatoire"

# Mot de passe du compte propriétaire créé par `npm run db:seed`.
# S'il n'est pas défini, le seed utilise « FNTC-admin-2026 ».
# ADMIN_MOTDEPASSE="votre-mot-de-passe-solide"
